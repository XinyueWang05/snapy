Cell[BoxData[
 RowBox[{
  RowBox[{"angles", "[",
   RowBox[{"k_", ",", "num_", ",", "p_"}], "]"}], ":=",
  RowBox[{"Module", "[",
   RowBox[{
    RowBox[{"{",
     RowBox[{
     "yghost", ",", "dA", ",", "corners", ",", "centers", ",", "baseVec", ",",
       "centerVec", ",", "xcenters"}], "}"}], ",", "\[IndentingNewLine]",
    RowBox[{
     RowBox[{"dA", "=",
      RowBox[{"\[Pi]", "/",
       RowBox[{"(",
        RowBox[{"2", "*", "num"}], ")"}]}]}], ";", "\[IndentingNewLine]",
     RowBox[{"corners", "=",
      RowBox[{"Table", "[",
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"-", "\[Pi]"}], "/", "4"}], "+",
         RowBox[{"dA", "*", "n"}]}], ",",
        RowBox[{"{",
         RowBox[{"n", ",", "0", ",", "num"}], "}"}]}], "]"}]}], ";",
     "\[IndentingNewLine]",
     RowBox[{"centers", "=",
      RowBox[{"Table", "[",
       RowBox[{
        RowBox[{
         RowBox[{"(",
          RowBox[{
           RowBox[{"corners", "[",
            RowBox[{"[", "i", "]"}], "]"}], "+",
           RowBox[{"corners", "[",
            RowBox[{"[",
             RowBox[{"i", "+", "1"}], "]"}], "]"}]}], ")"}], "/", "2"}], ",",

        RowBox[{"{",
         RowBox[{"i", ",", "1", ",", "num"}], "}"}]}], "]"}]}], ";",
     "\[IndentingNewLine]",
     RowBox[{"yghost", "=",
      RowBox[{"Tan", "[",
       RowBox[{
        RowBox[{"centers", "[",
         RowBox[{"[", "1", "]"}], "]"}], "+",
        RowBox[{"k", "*", "dA"}]}], "]"}]}], ";", "\[IndentingNewLine]",
     RowBox[{"baseVec", "=",
      RowBox[{"vecCube", "[",
       RowBox[{"0", ",", "yghost", ",", "p"}], "]"}]}], ";",
     "\[IndentingNewLine]",
     RowBox[{"xcenters", "=",
